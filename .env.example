# Copy to .env and edit what you need. Everything is optional.

# The owner key. Leave unset and one is generated on first start (printed in
# `docker compose logs cedar`, kept in the data volume as cedar.key).
# To pick your own (16+ characters of plain ASCII):  openssl rand -base64 24
# CEDAR_KEY=

# Shown in the app's Profile tab.
# CEDAR_SERVER_NAME=My Cedar server

# Host port the app connects to (default 8000).
# CEDAR_PORT=8000

# Which address the port is published on. 0.0.0.0 = every interface, so a
# phone on your Wi-Fi can connect directly. Set 127.0.0.1 when a reverse proxy
# on this same machine fronts the server: then nothing else can reach the
# plain-HTTP port (Docker publishes ports around the host firewall).
# CEDAR_BIND=0.0.0.0

# Reverse proxies whose X-Forwarded-For header the server trusts, so the
# wrong-key throttle sees real client addresses instead of the proxy's own.
# Comma-separated IPs or CIDRs; "*" only if the port is reachable through the
# proxy and nothing else.
# CEDAR_TRUSTED_PROXIES=127.0.0.1

# Size ceilings, in MB: file uploads, "import from link" downloads, and every
# other request body (pasted text, live pages).
# CEDAR_MAX_UPLOAD_MB=100
# CEDAR_MAX_FETCH_MB=60
# CEDAR_MAX_BODY_MB=8
